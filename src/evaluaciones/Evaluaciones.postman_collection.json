{
  "info": {
    "name": "Evaluaciones - API",
    "description": "Colección de endpoints para el módulo de Evaluaciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gestión de Evaluaciones",
      "item": [
        {
          "name": "Crear Evaluación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Examen Final - Matemáticas\",\n  \"puntaje_minimo\": 0,\n  \"puntaje_maximo\": 10,\n  \"id_tipo_evaluacion\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/evaluaciones",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones"]
            },
            "description": "Crea una nueva evaluación. Requiere rol Orientador o Admin."
          }
        },
        {
          "name": "Listar Todas las Evaluaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones"]
            },
            "description": "Obtiene todas las evaluaciones del sistema."
          }
        },
        {
          "name": "Obtener Evaluación por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/1",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "1"]
            },
            "description": "Obtiene los detalles de una evaluación específica."
          }
        },
        {
          "name": "Obtener Evaluaciones por Tipo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/tipo/1",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "tipo", "1"]
            },
            "description": "Obtiene todas las evaluaciones de un tipo específico."
          }
        },
        {
          "name": "Actualizar Evaluación",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Examen Final Actualizado\",\n  \"puntaje_maximo\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/1",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "1"]
            },
            "description": "Actualiza los datos de una evaluación. Requiere rol Orientador o Admin."
          }
        },
        {
          "name": "Eliminar Evaluación",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/1",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "1"]
            },
            "description": "Elimina una evaluación si no tiene notas asociadas. Requiere rol Orientador o Admin."
          }
        }
      ]
    },
    {
      "name": "Historial y Estadísticas",
      "item": [
        {
          "name": "Historial - Sin Filtros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/historial",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "historial"]
            },
            "description": "Obtiene el historial completo de evaluaciones. Requiere rol P.A o Admin."
          }
        },
        {
          "name": "Historial - Por Tipo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/historial?id_tipo_evaluacion=1",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "historial"],
              "query": [
                {
                  "key": "id_tipo_evaluacion",
                  "value": "1"
                }
              ]
            },
            "description": "Filtra el historial por tipo de evaluación."
          }
        },
        {
          "name": "Historial - Por Nombre",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/historial?nombre=Examen",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "historial"],
              "query": [
                {
                  "key": "nombre",
                  "value": "Examen"
                }
              ]
            },
            "description": "Busca evaluaciones por nombre (búsqueda parcial)."
          }
        },
        {
          "name": "Historial - Por Fechas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/historial?fecha_inicio=2025-01-01&fecha_fin=2025-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "historial"],
              "query": [
                {
                  "key": "fecha_inicio",
                  "value": "2025-01-01"
                },
                {
                  "key": "fecha_fin",
                  "value": "2025-12-31"
                }
              ]
            },
            "description": "Filtra el historial por rango de fechas."
          }
        },
        {
          "name": "Historial - Con Paginación",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/historial?pagina=1&limite=20",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "historial"],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "limite",
                  "value": "20"
                }
              ]
            },
            "description": "Obtiene el historial con paginación personalizada."
          }
        },
        {
          "name": "Historial - Filtros Combinados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/historial?id_tipo_evaluacion=1&nombre=Examen&fecha_inicio=2025-01-01&pagina=1&limite=10",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "historial"],
              "query": [
                {
                  "key": "id_tipo_evaluacion",
                  "value": "1"
                },
                {
                  "key": "nombre",
                  "value": "Examen"
                },
                {
                  "key": "fecha_inicio",
                  "value": "2025-01-01"
                },
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "limite",
                  "value": "10"
                }
              ]
            },
            "description": "Combina múltiples filtros en una sola consulta."
          }
        },
        {
          "name": "Estadísticas Generales",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluaciones/estadisticas",
              "host": ["{{baseUrl}}"],
              "path": ["evaluaciones", "estadisticas"]
            },
            "description": "Obtiene estadísticas generales del sistema de evaluaciones. Requiere rol P.A o Admin."
          }
        }
      ]
    },
