### Variables globales
@baseUrl = http://localhost:3000

### 1. Login como Orientador
# @name loginOrientador
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "orientador@colegio.edu",
    "password": "Ori12345*"
}

### Guardar token
@orientadorToken = {{loginOrientador.response.body.token}}

### 2. Crear una calificación
# @name crearCalificacion
POST {{baseUrl}}/calificaciones
Authorization: Bearer {{orientadorToken}}
Content-Type: application/json

{
    "id_evaluacion": 1,
    "id_alumno": 1,
    "calificacion": 8.5
}

### 3. Ver calificaciones de una evaluación
GET {{baseUrl}}/calificaciones?id_evaluacion=1
Authorization: Bearer {{orientadorToken}}

### 4. Actualizar una calificación
PATCH {{baseUrl}}/calificaciones/1
Authorization: Bearer {{orientadorToken}}
Content-Type: application/json

{
    "calificacion": 9.0
}

### 5. Eliminar una calificación
DELETE {{baseUrl}}/calificaciones/1
Authorization: Bearer {{orientadorToken}}