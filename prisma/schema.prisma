// schema.prisma
// Configuración inicial para usar variables de entorno del archivo .env

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Alumno {
  id_alumno Int    @id @default(autoincrement())
  nombre    String
  apellido  String
  // foto    Bytes? (removido para optimización)

  genero                   String?
  fechaNacimiento          String? // formato: DD/MM/YYYY para ser más manejable
  nacionalidad             String?
  edad                     Int?
  partidaNumero            String?
  folio                    String?
  libro                    String?
  anioPartida              String?
  departamentoNacimiento   String?
  municipioNacimiento      String?
  tipoSangre               String?
  problemaFisico           String?
  observacionesMedicas     String?
  centroAsistencial        String?
  medicoNombre             String?
  medicoTelefono           String?
  zonaResidencia           String?
  direccion                String?
  municipio                String?
  departamento             String?
  distanciaKM              Float?
  medioTransporte          String?
  encargadoTransporte      String?
  encargadoTelefono        String?
  repiteGrado              Boolean @default(false)
  condicionado             Boolean @default(false)
  activo                   Boolean @default(true)

  // ====== NUEVOS CAMPOS (ficha/matrícula vigente) ======
  anioEscolar     String? // NEW - Año escolar vigente (si no manejas Curso por año)
  numeroMatricula String?  @unique // NEW - Número de matrícula (opcionalmente único)
  fechaMatricula  DateTime? // NEW - Fecha de matrícula
  estadoMatricula String? // NEW - "INSCRITO", "RETIRADO", etc.

  // Autorizaciones de la ficha (vigentes)
  autorizaAtencionMedica      Boolean? @default(false) // NEW
  autorizaUsoImagen           Boolean? @default(false) // NEW
  autorizaActividadesReligiosas Boolean? @default(false) // NEW

  // Transporte escolar (bandera anual simple)
  usaTransporteEscolar        Boolean? @default(false) // NEW

  // Religión del alumno
  religion                    String? // NEW

  detalle Alumno_Detalle?

  // relaciones
  responsables AlumnoResponsable[]
  inscripciones     AlumnoCurso[]      // Relación explícita a través de tabla pivote
  asistencias  Asistencia[]
  Notas             Notas[]
  historialAcademico HistorialAcademico[]
  conductas Conducta[] // <== Relación a Conducta (sin cambios)
}

model Alumno_Detalle {
  alumnoId                Int      @id
  viveCon                 String?
  dependenciaEconomica    String?
  capacidadPago           Boolean?
  tieneHermanosEnColegio  Boolean? @default(false)
  hermanosEnColegio       Json? // Estructura: [{"nombre": "Nombre", "grado": "Grado"}]

  // ====== NUEVOS CAMPOS (ficha) ======
  // Contactos de emergencia libres (si no usas AlumnoResponsable como emergencia)
  emergencia1Nombre      String?  // NEW
  emergencia1Parentesco  String?  // NEW
  emergencia1Telefono    String?  // NEW
  emergencia2Nombre      String?  // NEW
  emergencia2Parentesco  String?  // NEW
  emergencia2Telefono    String?  // NEW

  // Tenencia / tipo de vivienda
  tenenciaVivienda       String?  // NEW

  alumno Alumno @relation(fields: [alumnoId], references: [id_alumno], onDelete: Cascade)
}

model Responsable {
  id_responsable       Int      @id @default(autoincrement())
  nombre               String
  apellido             String
  dui                  String?  @unique
  telefono             String?
  email                String?  @unique
  direccion            String?
  lugarTrabajo         String?
  profesionOficio      String?
  ultimoGradoEstudiado String?
  ocupacion            String?
  religion             String?
  zonaResidencia       String?
  estadoFamiliar       String?

  empresaTransporte String?
  placaVehiculo     String?
  tipoVehiculo      String?

  firmaFoto Bytes?

  // ====== NUEVOS CAMPOS (documento/naturalización/telefonía) ======
  tipoDocumento    String?        // NEW - "DUI", "Pasaporte", etc.
  numeroDocumento  String? @unique // NEW - Alternativa a DUI
  naturalizado     Boolean? @default(false) // NEW
  telefonoFijo     String?        // NEW

  //relaciones
  alumnos AlumnoResponsable[]
}

model Parentesco {
  id_parentesco Int                 @id @default(autoincrement())
  nombre        String              @unique // p.ej. Padre, Madre, Responsable legal, Transporte, Emergencia
  alumnos       AlumnoResponsable[]
}

model AlumnoResponsable {
  id                 Int       @id @default(autoincrement())
  alumnoId           Int
  responsableId      Int
  parentescoId       Int?
  parentescoLibre    String?
  esPrincipal        Boolean   @default(false)
  firma              Boolean   @default(false)
  firmaImagen        Bytes?
  permiteTraslado    Boolean   @default(false)
  puedeRetirarAlumno Boolean   @default(false)
  contactoEmergencia Boolean   @default(false)
  alumno             Alumno    @relation(fields: [alumnoId], references: [id_alumno], onDelete: Cascade)
  responsable        Responsable @relation(fields: [responsableId], references: [id_responsable], onDelete: Restrict)
  parentesco         Parentesco? @relation(fields: [parentescoId], references: [id_parentesco])

  @@unique([alumnoId, responsableId]) // evita duplicados del mismo responsable para el mismo alumno
  @@index([alumnoId, parentescoId])
  @@index([responsableId])
}

model Jornada {
  id_jornada       Int               @id @default(autoincrement())
  nombre           String
  gradoAcademico Grado_Academico[]
}

model Grado_Academico {
  id_grado_academico Int      @id @default(autoincrement())
  nombre             String
  opcion             String?
  n_anios            Int?
  nota_minima        Float?
  id_jornada         Int?
  rcup               Boolean?
  jornada            Jornada? @relation(fields: [id_jornada], references: [id_jornada])
  curso              Curso[]
}

model Curso {
  id_curso           Int      @id @default(autoincrement())
  nombre             String
  seccion            String?
  descripcion        String?
  id_grado_academico Int?
  id_orientador      Int?
  cupo               Int?
  aula               String?

  // (Opcional) si decides manejar curso por año en lugar de anioEscolar en Alumno
  anio_academico String? // NEW

  gradoAcademico Grado_Academico?             @relation(fields: [id_grado_academico], references: [id_grado_academico])
  orientador     Orientador?                  @relation(fields: [id_orientador], references: [id_orientador])
  inscripciones  AlumnoCurso[]               // Relación explícita a través de tabla pivote
  asignaturas    Asignatura[]
  activo         Boolean?                     @default(true)
  historialCurso Historial_curso_orientador[]
  historialAcademico HistorialAcademico[]
}

model Historial_curso_orientador {
  id_historial_curso_orientador Int       @id @default(autoincrement())
  id_curso                      Int
  id_orientador                 Int
  es_orientador                 Boolean   @default(false)
  id_asignatura                 Int? // null => principal, valor => docente de materia
  anio_academico                String?
  fecha_asignacion              DateTime?
  fecha_fin                     DateTime?
  curso                         Curso     @relation(fields: [id_curso], references: [id_curso])
  orientador                    Orientador @relation(fields: [id_orientador], references: [id_orientador])
  asignatura                    Asignatura? @relation("AsignaturaHistorial", fields: [id_asignatura], references: [id_asignatura])

  @@index([id_curso, id_orientador, id_asignatura])
  @@index([anio_academico])
  @@index([fecha_asignacion, fecha_fin])
}

model Asignatura {
  id_asignatura         Int        @id @default(autoincrement())
  nombre                String
  orden_en_reporte      String?
  horas_semanas         Float?
  id_metodo_evaluacion  Int?
  id_tipo_asignatura    Int?
  id_sistema_evaluacion Int?
  id_curso              Int?
  
  metodoEvaluacion      Metodo_evaluacion?   @relation(fields: [id_metodo_evaluacion], references: [id_metodo_evaluacion])
  tipoAsignatura        Tipo_Asignatura?     @relation(fields: [id_tipo_asignatura], references: [id_tipo_asignatura])
  sistemaEvaluacion     Sistema_Evaluacion?  @relation(fields: [id_sistema_evaluacion], references: [id_sistema_evaluacion])
  curso                 Curso?               @relation(fields: [id_curso], references: [id_curso])
  
  notas                 Notas[]
  orientadores          AsignaturaOrientador[]
  asistencias           Asistencia[]
  conductas             Conducta[]
  historialDocente      Historial_curso_orientador[] @relation("AsignaturaHistorial")
  evaluaciones          Evaluacion[]
}

model Metodo_evaluacion {
  id_metodo_evaluacion Int          @id @default(autoincrement())
  nombre               String
  asignaturas          Asignatura[]
}

model Tipo_Asignatura {
  id_tipo_asignatura Int          @id @default(autoincrement())
  nombre             String
  asignaturas        Asignatura[]
}

model Sistema_Evaluacion {
  id_sistema_evaluacion Int          @id @default(autoincrement())
  nombre                String
  etapas                Int
  asignaturas           Asignatura[]
}

model Notas {
  id_nota        Int        @id @default(autoincrement())
  id_asignatura  Int
  trimestre      String?
  id_evaluacion  Int?
  calificacion   Float?
  fecha_registro DateTime?
  id_alumno      Int
  asignatura     Asignatura @relation(fields: [id_asignatura], references: [id_asignatura])
  evaluacion     Evaluacion? @relation(fields: [id_evaluacion], references: [id_evaluacion])
  alumno         Alumno     @relation(fields: [id_alumno], references: [id_alumno])
}

model Evaluacion {
  id_evaluacion      Int            @id @default(autoincrement())
  nombre             String
  puntaje_maximo     Float?
  puntaje_minimo     Float?
  id_tipo_evaluacion Int
  id_asignatura      Int
  id_orientador      Int
  tipoEvaluacion     Tipo_evaluacion @relation(fields: [id_tipo_evaluacion], references: [id_tipo_evaluacion])
  asignatura         Asignatura     @relation(fields: [id_asignatura], references: [id_asignatura])
  orientador         Orientador     @relation(fields: [id_orientador], references: [id_orientador])
  notas              Notas[]
  
  @@index([id_orientador])
  @@index([id_asignatura])
}

model Tipo_evaluacion {
  id_tipo_evaluacion Int          @id @default(autoincrement())
  nombre             String
  activo             Boolean      @default(true)
  evaluaciones       Evaluacion[]
}

model Administrativo {
  id_administrativo         Int                  @id @default(autoincrement())
  id_cargo_administrativo   Int?
  nombre                    String
  apellido                  String
  direccion                 String
  dui                       String               @unique
  telefono                  String
  email                     String               @unique
  password                  String
  activo                    Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  cargoAdministrativo       Cargo_administrativo? @relation(fields: [id_cargo_administrativo], references: [id_cargo_administrativo])
  PasswordResetToken        PasswordResetToken[]

  @@map("administrativos")
}

model Cargo_administrativo {
  id_cargo_administrativo Int              @id @default(autoincrement())
  nombre                  String
  administrativos         Administrativo[]
  orientadores            Orientador[]
}

model Orientador {
  id_orientador           Int                  @id @default(autoincrement())
  nombre                  String
  apellido                String
  dui                     String               @unique
  direccion               String
  telefono                String
  email                   String               @unique
  password                String
  id_cargo_administrativo Int
  cargoAdministrativo     Cargo_administrativo?  @relation(fields: [id_cargo_administrativo], references: [id_cargo_administrativo])
  cursos                  Curso[]
  historialCurso          Historial_curso_orientador[]
  asignaturas             AsignaturaOrientador[]
  activo                  Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  PasswordResetToken      PasswordResetToken[]
  asistencias             Asistencia[]

  conductas Conducta[] // <== Relación a Conducta (sin cambios)
  evaluaciones Evaluacion[]

  @@map("orientadores")
}

model ActividadReciente {
  id_actividad Int      @id @default(autoincrement())
  descripcion  String   @db.Text
  tipo         String // 'success', 'info', 'warning'
  fecha        DateTime @default(now())
  entidad      String? // Puede ser 'alumno', 'responsable', 'administrativo', etc.
  entidad_id   Int? // ID de la entidad relacionada, si aplica
  usuario      String? // Email del usuario que realizó la acción

  @@index([fecha])
  @@map("actividades_recientes")
}

model PasswordResetToken {
  id           Int             @id @default(autoincrement())
  adminId      Int?
  orientadorId Int?
  tokenHash    String          @db.VarChar(128)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime        @default(now())
  ip           String?         @db.VarChar(64)
  userAgent    String?
  administrativo Administrativo? @relation(fields: [adminId], references: [id_administrativo], onDelete: Cascade)
  orientador   Orientador?     @relation(fields: [orientadorId], references: [id_orientador], onDelete: Cascade)

  @@index([adminId])
  @@index([orientadorId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AsignaturaOrientador {
  id_asignatura_orientador Int        @id @default(autoincrement())
  id_asignatura            Int
  id_orientador            Int
  anio_academico           String?
  activo                   Boolean    @default(true)
  fecha_asignacion         DateTime   @default(now())
  fecha_fin                DateTime?
  
  // Relaciones
  asignatura               Asignatura @relation(fields: [id_asignatura], references: [id_asignatura])
  orientador               Orientador @relation(fields: [id_orientador], references: [id_orientador])
  
  @@unique([id_asignatura, id_orientador, anio_academico])
  @@index([id_asignatura])
  @@index([id_orientador])
}

// ======================================================
// ========= MODELOS DE ASISTENCIA Y CONDUCTA ===========
// ======================================================

// --- ENUMS DE ASISTENCIA (Sin cambios) ---
enum AccionAsistencia {
  CREATE
  UPDATE
  DELETE
  BULK_IMPORT
  RECTIFY // corrección posterior (ej. justificó con constancia médica)
  ROLLBACK
}

enum EstadoAsistencia {
  P // Presente (Cumple nuevo requisito de marcar asistencia explícita)
  E // Excusado (Ausente CON permiso - Mapea a 'P' en consolidado)
  SP // Sin permiso (Ausente SIN permiso - Mapea a 'SP' en consolidado)
  A // Atraso (Llegada tardía)
}

// --- MODELO ASISTENCIA (Modificado para asistencia por curso) ---
model Asistencia {
  id_asistencia  Int      @id @default(autoincrement())
  id_alumno      Int
  id_asignatura  Int?     // ✅ OPCIONAL - Para mantener compatibilidad con registros antiguos
  id_orientador  Int      // Quién tomó la asistencia
  fecha          DateTime
  estado         EstadoAsistencia // P, E, SP, A
  observacion    String?
  creadoEn       DateTime @default(now())
  anio_academico String?
  trimestre      Int?
  alumno         Alumno      @relation(fields: [id_alumno], references: [id_alumno], onDelete: Cascade)
  asignatura     Asignatura? @relation(fields: [id_asignatura], references: [id_asignatura], onDelete: Cascade)
  orientador     Orientador  @relation(fields: [id_orientador], references: [id_orientador], onDelete: Cascade)
  historial      AsistenciaHistorial[] @relation("AsistenciaLog")

  @@unique([id_alumno, fecha]) // ✅ CAMBIO: Ahora solo alumno + fecha (una asistencia por día)
  @@index([fecha])
  @@index([trimestre])
  @@index([id_asignatura]) // Nuevo índice para consultas opcionales
}

model AsistenciaHistorial {
  id_historial           Int            @id @default(autoincrement())
  id_asistencia          Int?
  asistencia             Asistencia?    @relation("AsistenciaLog", fields: [id_asistencia], references: [id_asistencia], onDelete: SetNull)
  id_alumno              Int
  id_asignatura          Int?           // ✅ OPCIONAL - Para mantener compatibilidad
  fecha                  DateTime
  accion                 AccionAsistencia
  id_orientador_registro Int
  estado_anterior        EstadoAsistencia?
  estado_nuevo           EstadoAsistencia?
  observ_anterior        String?
  observ_nueva           String?
  creadoEn               DateTime       @default(now())

  @@index([id_asistencia])
  @@index([id_alumno, fecha]) // ✅ CAMBIO: Índice simplificado
  @@index([id_orientador_registro])
}

// --- NUEVO ENUM PARA CATEGORÍA DE INFRACCIÓN ---
enum CategoriaInfraccion {
  MENOS_GRAVE
  GRAVE
  MUY_GRAVE
}

// --- NUEVO MODELO: Catálogo de Infracciones ---
// Esta es la tabla maestra que alimenta el frontend.
model InfraccionCatalogo {
  id_infraccion Int                 @id @default(autoincrement())
  categoria     CategoriaInfraccion // El tipo: MENOS_GRAVE, GRAVE, MUY_GRAVE
  articulo      String              @unique // El código: "5.1.3 literal b"
  descripcion   String // La descripción legible: "Faltar al respeto..."
  puntos        Float // El "peso" o "conteo" (ej. 1, 2, o 0.3)
  
  activo        Boolean             @default(true) // Para poder desactivar infracciones viejas

  // Relación inversa:
  // Historial de cuántas veces se ha cometido esta falta
  instancias Conducta[]

  @@map("infracciones_catalogo")
}

// --- MODELO MODIFICADO: Conducta ---
// Registra una instancia de una infracción cometida por un alumno.
model Conducta {
  id_conducta Int  @id @default(autoincrement())
  id_alumno   Int
  fecha       DateTime // Cuándo ocurrió

  // --- Foreign Key al catálogo ---
  id_infraccion_catalogo Int
  infraccion             InfraccionCatalogo @relation(fields: [id_infraccion_catalogo], references: [id_infraccion])
  // --- Fin Foreign Key ---

  // Campos de contexto (opcionales)
  id_orientador Int? // Quién la reportó
  id_asignatura Int? // Dónde ocurrió (en qué clase)
  observacion   String? // Notas específicas del incidente (ej. "Llamó 'X' al compañero 'Y'")

  // Campos para reportes
  anio_academico String?
  trimestre      Int?

  // Relaciones
  alumno     Alumno     @relation(fields: [id_alumno], references: [id_alumno], onDelete: Cascade)
  orientador Orientador? @relation(fields: [id_orientador], references: [id_orientador])
  asignatura Asignatura? @relation(fields: [id_asignatura], references: [id_asignatura])

  @@index([id_alumno])
  @@index([fecha])
  @@index([id_infraccion_catalogo]) // Nuevo índice
}
// Tabla pivote para la relación muchos a muchos entre Alumno y Curso
model AlumnoCurso {
  id                Int       @id @default(autoincrement())
  alumnoId          Int
  cursoId           Int
  fechaInscripcion  DateTime  @default(now())
  fechaRetiro       DateTime?  // Fecha en que se retira del curso o se promueve
  seccionAsignada   String?   // Por si la sección es diferente del curso principal
  anioAcademico     String    // Permite manejar inscripciones de diferentes años
  estado            String    // "ACTIVO", "INACTIVO" (cuando se retira o se promueve)
  observaciones     String?   @db.Text
  
  // Relaciones
  alumno            Alumno    @relation(fields: [alumnoId], references: [id_alumno], onDelete: Cascade)
  curso             Curso     @relation(fields: [cursoId], references: [id_curso], onDelete: Restrict)

  @@unique([alumnoId, cursoId, anioAcademico])
  @@index([alumnoId])
  @@index([cursoId])
  @@index([anioAcademico])
  @@index([estado])
}

// Historial académico del alumno
model HistorialAcademico {
  id                Int      @id @default(autoincrement())
  alumnoId          Int
  cursoId           Int
  anioAcademico     String   // Ej: "2025"
  estadoFinal       String?  // "APROBADO", "REPROBADO", "FINALIZADO", etc.
  notaPromedio      Float?   // Nota promedio final
  observaciones     String?  @db.Text
  fechaInicio       DateTime @default(now())
  fechaFin          DateTime?
  
  // Relaciones
  alumno            Alumno   @relation(fields: [alumnoId], references: [id_alumno], onDelete: Cascade)
  curso             Curso    @relation(fields: [cursoId], references: [id_curso], onDelete: Restrict)

  @@unique([alumnoId, cursoId, anioAcademico])
  @@index([alumnoId])
  @@index([cursoId])
  @@index([anioAcademico])
}
